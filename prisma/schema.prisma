generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StreamStatus {
  LIVE
  OFFLINE
  SCHEDULED
  RESTRICTED
  UNKNOWN
}

enum MediaType {
  LIVE_VIDEO
  SNAPSHOT
  TIMELAPSE
  RECORDED
}

model Country {
  id      String @id @default(cuid())
  isoCode String @unique @map("iso_code")
  name    String
  slug    String @unique
  flag    String @default("🌍")
  cities  City[]

  @@map("countries")
}

model City {
  id        String   @id @default(cuid())
  countryId String   @map("country_id")
  name      String
  slug      String
  lat       Float
  lng       Float
  timezone  String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  webcams   Webcam[]

  @@unique([countryId, slug])
  @@map("cities")
}

model Category {
  id      String           @id @default(cuid())
  slug    String           @unique
  name    String
  webcams WebcamCategory[]

  @@map("categories")
}

model Provider {
  id       String   @id @default(cuid())
  name     String
  type     String   // "youtube_channel" | "tourism_board" | "hotel" | "observatory"
  website  String?
  contact  String?  // Never exposed in public APIs
  verified Boolean  @default(false)
  webcams  Webcam[]

  @@map("providers")
}

model Webcam {
  id           String           @id @default(cuid())
  providerId   String?          @map("provider_id")
  cityId       String           @map("city_id")
  slug         String           @unique
  title        String
  description  String
  bestTime     String?          @map("best_time")
  lat          Float
  lng          Float
  reviewStatus ReviewStatus     @default(PENDING) @map("review_status")
  visibility   String           @default("PUBLIC")
  isFeatured   Boolean          @default(false) @map("is_featured")
  viewCount    Int              @default(0) @map("view_count")
  favoriteCount Int             @default(0) @map("favorite_count")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  provider   Provider?        @relation(fields: [providerId], references: [id])
  city       City             @relation(fields: [cityId], references: [id])
  categories WebcamCategory[]
  streams    Stream[]
  licenses   License[]
  reports    Report[]
  favorites  UserFavorite[]

  @@index([reviewStatus, cityId])
  @@index([lat, lng])
  @@map("webcams")
}

model WebcamCategory {
  webcamId   String   @map("webcam_id")
  categoryId String   @map("category_id")
  webcam     Webcam   @relation(fields: [webcamId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([webcamId, categoryId])
  @@map("webcam_categories")
}

model Stream {
  id                  String       @id @default(cuid())
  webcamId            String       @map("webcam_id")
  sourceType          String       @map("source_type") // "youtube" | "official_embed"
  externalId          String       @map("external_id")
  channelId           String?      @map("channel_id")
  embedUrl            String       @map("embed_url")
  sourceUrl           String       @map("source_url")
  mediaType           MediaType    @default(LIVE_VIDEO) @map("media_type")
  status              StreamStatus @default(UNKNOWN)
  consecutiveFailures Int          @default(0) @map("consecutive_failures")
  lastCheckedAt       DateTime?    @map("last_checked_at")
  nextCheckAt         DateTime     @default(now()) @map("next_check_at")
  isPrimary           Boolean      @default(true) @map("is_primary")

  webcam       Webcam        @relation(fields: [webcamId], references: [id], onDelete: Cascade)
  healthChecks HealthCheck[]

  @@unique([sourceType, externalId])
  @@index([status, lastCheckedAt])
  @@index([nextCheckAt])
  @@map("streams")
}

model License {
  id             String    @id @default(cuid())
  webcamId       String    @map("webcam_id")
  permissionType String    @map("permission_type")
  evidence       String    // Never exposed in public APIs
  verifiedAt     DateTime  @default(now()) @map("verified_at")
  expiresAt      DateTime? @map("expires_at")
  status         String    @default("ACTIVE")

  webcam Webcam @relation(fields: [webcamId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model DiscoveryJob {
  id        String   @id @default(cuid())
  source    String
  query     String
  status    String   @default("IDLE")
  attempts  Int      @default(0)
  quotaCost Int      @default(0) @map("quota_cost")
  lastRunAt DateTime? @map("last_run_at")
  nextRunAt DateTime @default(now()) @map("next_run_at")

  @@map("discovery_jobs")
}

model Candidate {
  id             String       @id @default(cuid())
  source         String
  sourceType     String       @default("official_embed") @map("source_type")
  mediaType      MediaType    @default(LIVE_VIDEO) @map("media_type")
  externalId     String       @map("external_id")
  channelId      String?      @map("channel_id")
  title          String
  description    String?
  countryName    String       @map("country_name")
  cityName       String       @map("city_name")
  lat            Float        @default(0)
  lng            Float        @default(0)
  categorySlug   String       @map("category_slug")
  embedUrl       String       @map("embed_url")
  sourceUrl      String       @map("source_url")
  licenseNote    String       @map("license_note")
  privacyNote    String       @map("privacy_note")
  stabilityScore Int          @default(80) @map("stability_score")
  lastProbedAt   DateTime?    @map("last_probed_at")
  reviewStatus   ReviewStatus @default(PENDING) @map("review_status")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([source, externalId])
  @@map("candidates")
}

model Submission {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String
  location    String
  sourceUrl   String       @map("source_url")
  operator    String?
  contact     String       // Never exposed in public APIs
  declaration Boolean      @default(false)
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("submissions")
}

model HealthCheck {
  id        String       @id @default(cuid())
  streamId  String       @map("stream_id")
  status    StreamStatus
  reason    String?
  checkedAt DateTime     @default(now()) @map("checked_at")

  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@map("health_checks")
}

model Report {
  id          String   @id @default(cuid())
  webcamId    String   @map("webcam_id")
  type        String
  description String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at")

  webcam Webcam @relation(fields: [webcamId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  passwordHash    String?        @map("password_hash")
  githubId        String?        @unique @map("github_id")
  googleId        String?        @unique @map("google_id")
  avatarUrl       String?        @map("avatar_url")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  role            String         @default("USER")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  favorites       UserFavorite[]

  @@map("users")
}

model UserFavorite {
  userId    String   @map("user_id")
  webcamId  String   @map("webcam_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  webcam Webcam @relation(fields: [webcamId], references: [id], onDelete: Cascade)

  @@id([userId, webcamId])
  @@map("user_favorites")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification_codes")
}

model Translation {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type") // "webcam" | "city" | "country" | "category"
  entityId    String   @map("entity_id")
  locale      String
  title       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, locale])
  @@index([entityType, locale])
  @@map("translations")
}

model SeoRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("seo_redirects")
}
